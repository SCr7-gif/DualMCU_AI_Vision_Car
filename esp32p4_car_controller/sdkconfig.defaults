CONFIG_IDF_TARGET="esp32p4"
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# CONFIG_ESP32P4_REV_MIN_301 is not set
CONFIG_ESP32P4_REV_MIN_FULL=100
CONFIG_ESP_REV_MIN_FULL=100
CONFIG_ESP32P4_REV_MAX_FULL=299
CONFIG_ESP_REV_MAX_FULL=299
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ROBOT_NETWORK_WAVESHARE_P4_WIFI6_KIT=y
CONFIG_ROBOT_WIFI6_KIT_ENABLE_HOSTED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
# Waveshare ESP32-P4-WIFI6-KIT uses the same P4<->C6 SDIO pin map as
# Espressif's P4 Function EV board: P4 GPIO18/19/14/15/16/17 -> C6
# GPIO19/18/20/21/22/23, reset on P4 GPIO54 -> C6 CHIP_PU.
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE is not set
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ROBOT_CAMERA_V4L2_CAPTURE=y
CONFIG_ROBOT_CAMERA_V4L2_DEVICE="/dev/video0"
CONFIG_ROBOT_CAMERA_JPEG_WIDTH=320
CONFIG_ROBOT_CAMERA_JPEG_HEIGHT=240
CONFIG_ROBOT_CAMERA_STREAM_FPS=6
CONFIG_ROBOT_CAMERA_STREAM_SLOW_FPS=2
CONFIG_ROBOT_CAMERA_JPEG_QUALITY=50
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_HW_JPEG_VIDEO_DEVICE=y
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
